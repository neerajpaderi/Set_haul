# AWS credentials for calling the Bedrock AgentCore runtime (server-side only).
# Picked up automatically by the AWS SDK v3 default credential provider chain —
# omit these and use an IAM role / `aws configure` profile instead if not running locally.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="MY_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="MY_AWS_SECRET_ACCESS_KEY"

# ARN of the deployed Bedrock AgentCore agent runtime (from the AgentCore
# console / CreateAgentRuntime output).
BEDROCK_AGENTCORE_RUNTIME_ARN="arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:runtime/YOUR_RUNTIME_ID"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase (server-side only — the service_role key bypasses RLS and must
# never be exposed to the browser or prefixed with VITE_).
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
